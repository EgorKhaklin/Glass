# A program you can prove. Run:
#
#   glass prove examples/prove/hello_prove.glass inp=9
#
# Default proofs are sound but not zero-knowledge: add --zk to hide the private inputs.
#
# `glass prove` compiles `main` (the last expression) into an arithmetic circuit
# and proves its result. Any name passed on the command line (here `inp`) is a
# PRIVATE input: it stays in the witness. With --zk the proof reveals only the
# result. Supported: arithmetic, `let`, function calls, comparisons, `if`, `match`
# over (nested) ADTs and patterns, tuples, records, strings, bounded recursion
# (fact_prove.glass), recursive datatypes and linked lists (list_sum_prove.glass),
# and higher-order functions (map_prove.glass).

fn sq(n: Int) : Int = n * n
fn f(x: Int) : Int = sq(x) + 5      # f(9) = 81 + 5 = 86

f(inp)
