# H3 milestone — IN-CIRCUIT MERKLE MEMBERSHIP (the recursive-verifier building block).
#
# The roadmap's open H3 piece: "the fold-check-as-circuit is done; composing it with in-circuit
# Merkle membership (openings authenticated against the commitment INSIDE the circuit) hasn't
# shipped." A recursive verifier must re-hash a leaf up its authentication path within the proven
# circuit. Here that path-hashing is written as an ordinary Glass program (x^7 + a 3x3 MDS mix —
# all +,*, which the bridge lowers to field gates) and `glass prove` turns it into a circuit:
#
#   glass prove --witness3 examples/prove/merkle_member.glass leaf=42 s0=7 d0=0 s1=99 d1=1
#
# leaf + siblings + directions are PRIVATE inputs; the proof's PUBLIC result is the Merkle root
# the path authenticates to — "I know a leaf in the tree with root R", revealing only R. A reduced
# algebraic compression keeps the trace small enough to dogfood (the prove_preimage_zk pattern);
# scaling to full Poseidon2 per node + composing with the FRI fold-check is the continuing H3 work.

fn sb(x: Int) : Int = let x2 : Int = x * x in let x4 : Int = x2 * x2 in (x4 * x2) * x   # x^7 S-box
# one 2-to-1 compression: state (l, r, 0); 3 rounds of (add round const, x^7 all lanes,
# MDS mix [[2,3,1],[1,2,3],[3,1,2]]); squeeze lane 0. Two lanes discarded => one-way.
fn compress(l: Int, r: Int) : Int =
  let a1 : Int = sb(l + 1) in let b1 : Int = sb(r + 2) in let c1 : Int = sb(0 + 3) in
  let a2 : Int = 2 * a1 + 3 * b1 + c1 in let b2 : Int = a1 + 2 * b1 + 3 * c1 in let c2 : Int = 3 * a1 + b1 + 2 * c1 in
  let a3 : Int = sb(a2 + 4) in let b3 : Int = sb(b2 + 5) in let c3 : Int = sb(c2 + 6) in
  let a4 : Int = 2 * a3 + 3 * b3 + c3 in let b4 : Int = a3 + 2 * b3 + 3 * c3 in let c4 : Int = 3 * a3 + b3 + 2 * c3 in
  let a5 : Int = sb(a4 + 7) in let b5 : Int = sb(b4 + 8) in let c5 : Int = sb(c4 + 9) in
  2 * a5 + 3 * b5 + c5
# climb one level: direction d picks whether the current node is the left (0) or right (1) child
fn step(cur: Int, sib: Int, d: Int) : Int = if d == 0 then compress(cur, sib) else compress(sib, cur)
# a depth-2 authentication path: leaf -> (sib0,dir0) -> (sib1,dir1) -> root
fn root2(leaf: Int, s0: Int, d0: Int, s1: Int, d1: Int) : Int = step(step(leaf, s0, d0), s1, d1)

root2(leaf, s0, d0, s1, d1)
