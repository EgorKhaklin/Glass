# poseidon_perm difftest (STAGE 1 of the rope-cut): the unboxed native Poseidon intrinsic
# (q_poseidon_perm / glass.py b_poseidon_perm) must (1) hit the Plonky2 known-answer anchor,
# (2) match a hand-written Glass goldw_* reference permutation elementwise, and (3) produce
# byte-IDENTICAL output under the interpreter and the native compiler. No bridge import.
#
#   python3 glass.py examples/prove/poseidon_difftest.glass
#   bash examples/selfhost/run_native.sh examples/prove/poseidon_difftest.glass
#   diff the two -> empty, and every CHECK must be T.
# A lane is ONE Int = the u64 bit-pattern (canonical values >= 2^63 read negative).

fn nth(xs: List<Int>, i: Int) : Int = match xs { [] => 0; [h, ...t] => if i == 0 then h else nth(t, i - 1) }
fn idn(n: Int, i: Int) : List<Int> = if i >= n then [] else [i] ++ idn(n, i + 1)
fn sb(b: Bool) : String = if b then "T" else "F"

