fn arcat(i: Int) : Int = nth(arctab_(0), i)
fn gcirc(i: Int) : Int = nth([17, 15, 41, 16, 2, 28, 13, 13, 39, 18, 34, 20], i)
fn gsbox(x: Int) : Int = let x2 : Int = goldw_mul(x, x) in let x4 : Int = goldw_mul(x2, x2) in let x3 : Int = goldw_mul(x, x2) in goldw_mul(x3, x4)
fn gclayer(st: List<Int>, rc: Int, i: Int) : List<Int> = if i >= 12 then [] else [goldw_add(nth(st, i), arcat(rc * 12 + i))] ++ gclayer(st, rc, i + 1)
fn gsbox_all(st: List<Int>, i: Int) : List<Int> = if i >= 12 then [] else [gsbox(nth(st, i))] ++ gsbox_all(st, i + 1)
fn gdrop1(st: List<Int>) : List<Int> = match st { [] => []; [h, ...t] => t }
fn gsbox0(st: List<Int>) : List<Int> = [gsbox(nth(st, 0))] ++ gdrop1(st)
fn gmds_row(st: List<Int>, r: Int, i: Int, acc: Int) : Int = if i >= 12 then acc else gmds_row(st, r, i + 1, goldw_add(acc, goldw_mul(nth(st, (i + r) % 12), gcirc(i))))
fn gmds_one(st: List<Int>, r: Int) : Int = let base : Int = gmds_row(st, r, 0, 0) in if r == 0 then goldw_add(base, goldw_mul(nth(st, 0), 8)) else base
fn gmds(st: List<Int>, r: Int) : List<Int> = if r >= 12 then [] else [gmds_one(st, r)] ++ gmds(st, r + 1)
fn gfull(st: List<Int>, rc: Int) : List<Int> = gmds(gsbox_all(gclayer(st, rc, 0), 0), 0)
fn gpart(st: List<Int>, rc: Int) : List<Int> = gmds(gsbox0(gclayer(st, rc, 0)), 0)
fn gdofull(st: List<Int>, rc: Int, stop: Int) : List<Int> = if rc >= stop then st else gdofull(gfull(st, rc), rc + 1, stop)
fn gdopart(st: List<Int>, rc: Int, stop: Int) : List<Int> = if rc >= stop then st else gdopart(gpart(st, rc), rc + 1, stop)
fn gperm(st: List<Int>) : List<Int> = gdofull(gdopart(gdofull(st, 0, 4), 4, 26), 26, 30)

fn eqlist(a: List<Int>, b: List<Int>) : Bool = match a { [] => (match b { [] => true; _ => false }); [ha, ...ta] => match b { [] => false; [hb, ...tb] => if ha == hb then eqlist(ta, tb) else false } }
fn matches(st: List<Int>) : Bool = eqlist(poseidon_perm(st), gperm(st))
fn joinl(xs: List<Int>) : String = match xs { [] => ""; [h, ...t] => int_to_string(h) ++ "," ++ joinl(t) }

let in0 : List<Int> = idn(12, 0)
let in1 : List<Int> = [goldw_mul(7, 7), 3, goldw_sub(0, 1), 999999999, 0, 1, 2, 3, 4, 5, 6, 7]
let in2 : List<Int> = [goldw_inv(123456789), 18446744069414584320, 65535, 0, 0, 0, 0, 0, 0, 0, 0, 0]
let _ : String = print("CHECK anchor " ++ sb(nth(poseidon_perm(in0), 0) == 0 - 3004430645538877794))
let _ : String = print("CHECK ref_in0 " ++ sb(matches(in0)))
let _ : String = print("CHECK ref_in1 " ++ sb(matches(in1)))
let _ : String = print("CHECK ref_in2 " ++ sb(matches(in2)))
let _ : String = print("PERM in0 " ++ joinl(poseidon_perm(in0)))
let _ : String = print("PERM in1 " ++ joinl(poseidon_perm(in1)))
let _ : String = print("PERM in2 " ++ joinl(poseidon_perm(in2)))
"done"
