# =============================================================================
# xparam_refine.glass: cross-parameter refinement.
#
# A refinement predicate may mention EARLIER params, not only its own
# bound param. The host binds all params before checking (apply_fn).
#
# prism threads the already-applied args through its VRefinedClos
# chain (carrying real param names from the FnDecl), and Quartz may
# reference in-scope params. `hi > lo` resolves `lo`: the first
# param: at the point `hi`'s refinement is checked.
#
# clamp(3, 10): 3 < 10 so hi > lo holds; returns 10 - 3 = 7.
# =============================================================================

fn clamp(lo: Int, hi: Int where (hi > lo)) : Int = hi - lo
let r : Int = clamp(3, 10)
r
