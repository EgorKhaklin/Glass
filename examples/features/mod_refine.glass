# =============================================================================
# mod_refine.glass: parity refinement using `%`.
#
# `%` lets divisibility / parity refinements (`n % 2 == 0`) be expressed.
# It works end-to-end (host + Quartz + prism), and Quartz's refinement
# predicate compiler handles the canonical `binder % K OP M`
# shape so parity guards compile to native C.
#
# 10 is even, so the predicate holds and the call returns 11.
# =============================================================================

fn even_only(n: Int where (n % 2 == 0)) : Int = n + 1
let r : Int = even_only(10)
r
